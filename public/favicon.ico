<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#020617"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#22d3ee"/>
      <stop offset="50%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#8b5cf6"/>
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="3" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- App Rounded Rect Badge -->
  <rect x="2" y="2" width="60" height="60" rx="16" fill="url(#bg)" stroke="url(#accent)" stroke-width="2.5"/>

  <!-- Glowing Accent Nova Star / Sparkle Glyph -->
  <g filter="url(#glow)">
    <!-- Main 4-point Diamond Star -->
    <path d="M 32 14 C 32 24, 24 32, 14 32 C 24 32, 32 40, 32 50 C 32 40, 40 32, 50 32 C 40 32, 32 24, 32 14 Z" fill="url(#accent)"/>
    
    <!-- Mini Satellite Sparkle -->
    <path d="M 46 16 C 46 18.5, 44 20, 42 20 C 44 20, 46 21.5, 46 24 C 46 21.5, 48 20, 50 20 C 48 20, 46 18.5, 46 16 Z" fill="#38bdf8"/>
    
    <!-- Core Bright Dot -->
    <circle cx="32" cy="32" r="3" fill="#ffffff" />
  </g>
</svg>
